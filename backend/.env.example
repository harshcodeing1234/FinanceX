# FinanceX Backend Environment Configuration Template
PROJECT_NAME="FinanceX API"
API_V1_STR="/api/v1"

# In production, generate a secure 64-hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite (absolute or relative) or PostgreSQL:
# e.g.: postgresql://user:password@localhost:5432/financex
DATABASE_URL="sqlite:///./financex.db"

# ML Models Directory:
# Relative to repository root or absolute path
ML_MODELS_DIR="../ML/model"
